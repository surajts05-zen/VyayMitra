# Node & App Configuration
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:5173
API_URL=http://localhost:3000
ENABLE_API_DOCS=true
WRITE_OPENAPI_FILE=true
ALLOW_OFFLINE_DATABASE=true
REQUEST_BODY_LIMIT=1mb
TRUST_PROXY=
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=20

# Database (PostgreSQL)
# Locally runnable without Docker:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vyaymitra?schema=public"
DATABASE_URL_TEST="postgresql://postgres:postgres@localhost:5432/vyaymitra_test?schema=public"

# Redis & Queues
REDIS_URL="redis://localhost:6379"
USE_MOCK_REDIS=true

# Authentication (JWT & OIDC)
JWT_SECRET="vyaymitra-super-secret-jwt-key-minimum-32-chars-long"
JWT_REFRESH_SECRET="vyaymitra-super-secret-refresh-key-minimum-32-chars"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
API_CREDENTIAL_PEPPER="development-api-key-pepper-change-in-production"
GOOGLE_OIDC_CLIENT_ID=""
GOOGLE_OIDC_CLIENT_SECRET=""
GOOGLE_OIDC_CALLBACK_URL="http://localhost:3000/api/v1/auth/google/callback"

# Storage (S3 / Local Object Storage)
S3_ENDPOINT="http://localhost:9000"
S3_BUCKET="vyaymitra-receipts"
S3_ACCESS_KEY="mock-access-key"
S3_SECRET_KEY="mock-secret-key"
S3_REGION="ap-south-1"
USE_LOCAL_STORAGE=true

# Zoho Books Integration (Server-side secrets only)
ZOHO_CLIENT_ID="1000.EXAMPLEZOHOCLIENTID"
ZOHO_CLIENT_SECRET="example_zoho_client_secret_do_not_leak"
ZOHO_REDIRECT_URI="http://localhost:3000/api/v1/integrations/zoho-books/callback"
ZOHO_TOKEN_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# OCR Provider Configuration (stub by default)
OCR_PROVIDER="stub"

# Outbound Webhook Signing
WEBHOOK_SIGNING_SECRET="vyaymitra-webhook-signing-secret"

# M7 observability and retention
# Required in production; use at least 32 cryptographically random characters.
OBSERVABILITY_TOKEN="development-observability-token-change-me"
RETENTION_SIGNING_SECRET="development-retention-preview-secret-change-me"
RETENTION_OCR_PAYLOAD_DAYS=30
RETENTION_WEBHOOK_DELIVERY_DAYS=90
RETENTION_OUTBOX_PAYLOAD_DAYS=30
# Execution is preview-only unless an operator explicitly enables this.
ENABLE_RETENTION_EXECUTION=false
